{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "1c",
  "skills": ["./skills"],
  "mcp": {
    "servers": {
      "1c-search": {
        "type": "local",
        "command": ["node", "./mcp/code-search.mjs"],
        "timeout": { "startup": 10000, "catalog": 10000 }
      },
      "1c-bsl": {
        "type": "local",
        "command": ["node", "./mcp/bsl-ls.mjs"],
        "timeout": { "startup": 30000, "catalog": 30000 }
      },
      "vrunner": {
        "type": "local",
        "command": ["vrunner-mcp"],
        "timeout": { "startup": 30000, "catalog": 30000 },
        "disabled": true
      }
    }
  }
}
