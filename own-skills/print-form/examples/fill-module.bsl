// Эталонный модуль заполнения печатной формы по макету (счёт на оплату, макет examples/invoice.json).
// Внешний вид — только в макете. Код получает области, заполняет параметры и выводит их.

#Область ПрограммныйИнтерфейс

// Внешняя печатная форма БСП: процедура Печать модуля объекта обработки
// (каркас создают epf-bsp-init / epf-bsp-add-command, Модификатор = "ПечатьMXL").
Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "СчетНаОплату");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = ПечатьСчета(МассивОбъектов, ОбъектыПечати, ПолучитьМакет("ПФ_MXL_СчетНаОплату"));
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Счёт на оплату'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьСчета(МассивОбъектов, ОбъектыПечати, Макет) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СчетНаОплату";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;

	// Области получаем один раз
	ОбластьЗаголовок    = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока       = Макет.ПолучитьОбласть("Строка");
	ОбластьИтого        = Макет.ПолучитьОбласть("Итого");
	ОбластьПодписи      = Макет.ПолучитьОбласть("Подписи");

	// Данные — одним пакетом по всем документам
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Организация КАК Организация,
	|	Док.Контрагент КАК Контрагент,
	|	Док.Договор КАК Основание,
	|	Док.Ответственный КАК Бухгалтер
	|ИЗ
	|	Документ.СчетНаОплату КАК Док
	|ГДЕ
	|	Док.Ссылка В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата
	|;
	|ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.НомерСтроки КАК НомерСтроки,
	|	Т.Номенклатура КАК СсылкаНоменклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура) КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
	|	Т.Количество КАК Количество,
	|	Т.Цена КАК Цена,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаНДС КАК СуммаНДС
	|ИЗ
	|	Документ.СчетНаОплату.Товары КАК Т
	|ГДЕ
	|	Т.Ссылка В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Т.НомерСтроки";
	Пакет = Запрос.ВыполнитьПакет();
	ВыборкаШапок = Пакет[0].Выбрать();
	ТаблицаСтрок = Пакет[1].Выгрузить();
	ТаблицаСтрок.Индексы.Добавить("Ссылка");

	ПервыйДокумент = Истина;
	Пока ВыборкаШапок.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;

		ОбластьЗаголовок.Параметры.Заполнить(ВыборкаШапок);   // шаблон «Счёт на оплату № [Номер] от [Дата]»
		ОбластьЗаголовок.Параметры.Дата = Формат(ВыборкаШапок.Дата, "ДЛФ=DD");
		ТабДок.Вывести(ОбластьЗаголовок);

		ОбластьШапка.Параметры.Заполнить(ВыборкаШапок);
		ОбластьШапка.Параметры.ПредставлениеПоставщика = Строка(ВыборкаШапок.Организация);
		ОбластьШапка.Параметры.ПредставлениеПокупателя = Строка(ВыборкаШапок.Контрагент);
		ТабДок.Вывести(ОбластьШапка);

		ТабДок.Вывести(ОбластьШапкаТаблицы);

		Строки = ТаблицаСтрок.НайтиСтроки(Новый Структура("Ссылка", ВыборкаШапок.Ссылка));
		Всего = 0;
		ВсегоНДС = 0;
		Для Индекс = 0 По Строки.ВГраница() Цикл
			СтрокаТЧ = Строки[Индекс];
			ОбластьСтрока.Параметры.Заполнить(СтрокаТЧ);   // в т.ч. расшифровка СсылкаНоменклатура
			Всего = Всего + СтрокаТЧ.Сумма;
			ВсегоНДС = ВсегоНДС + СтрокаТЧ.СуммаНДС;

			// Разрыв страницы: строка (а для последней — строка + итоги + подписи) должна поместиться
			ПроверяемыеОбласти = Новый Массив;
			ПроверяемыеОбласти.Добавить(ОбластьСтрока);
			Если Индекс = Строки.ВГраница() Тогда
				ПроверяемыеОбласти.Добавить(ОбластьИтого);
				ПроверяемыеОбласти.Добавить(ОбластьПодписи);
			КонецЕсли;
			Если Не ТабДок.ПроверитьВывод(ПроверяемыеОбласти) Тогда
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
				ТабДок.Вывести(ОбластьШапкаТаблицы);   // повтор шапки таблицы на новой странице
			КонецЕсли;
			ТабДок.Вывести(ОбластьСтрока);
		КонецЦикла;

		ОбластьИтого.Параметры.Всего = Всего;
		ОбластьИтого.Параметры.ВсегоНДС = ВсегоНДС;
		ОбластьИтого.Параметры.КоличествоНаименований = Строки.Количество();
		ОбластьИтого.Параметры.ВсегоСтрокой = Формат(Всего, "ЧДЦ=2");
		ОбластьИтого.Параметры.СуммаПрописью = ЧислоПрописью(Всего, "L=ru_RU; ДП=Истина",
			"рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
		ТабДок.Вывести(ОбластьИтого);

		ОбластьПодписи.Параметры.Заполнить(ВыборкаШапок);
		ТабДок.Вывести(ОбластьПодписи);

		// БСП: связать область документа с объектом печати (для отправки по почте, комплектов)
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапок.Ссылка);

	КонецЦикла;

	Возврат ТабДок;

КонецФункции

#КонецОбласти
