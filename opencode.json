{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "1c-ask": {
      "type": "local",
      "command": [
        "node",
        "./mcp/ask-user.mjs"
      ],
      "enabled": true,
      "timeout": 600
    },
    "1c-search": {
      "type": "local",
      "command": [
        "node",
        "./mcp/code-search.mjs"
      ],
      "enabled": true,
      "timeout": 600
    },
    "1c-bsl": {
      "type": "local",
      "command": [
        "node",
        "./mcp/bsl-ls.mjs"
      ],
      "enabled": true,
      "timeout": 300
    }
  }
}
