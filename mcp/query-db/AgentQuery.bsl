// HTTP-сервис чтения данных. Корневой URL: agentquery. Шаблон: query. Метод: POST.
// Обработчик: QueryPOST. Модуль только читает: пакет из ВЫБРАТЬ / SELECT и УНИЧТОЖИТЬ
// временной таблицы. Произвольный код не выполняется.
//
// Поставить в конфигурацию или расширение навыком db-* (агент 1c-deployer), затем web-publish.
// Адрес вызова: <webUrl>/hs/agentquery/query  или  databases[].queryUrl.
// Аутентификация — пользователь публикации (Basic). Пароль в журнал сервиса не пишется.
// Клиент query_db сам обрывает HTTP по таймауту; платформа не отдаёт отмену уже начатого запроса СУБД.

Функция QueryPOST(Запрос)
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку("UTF-8"));
		Данные = ПрочитатьJSON(Чтение);
		Текст = "";
		Лимит = 100;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Если Данные.Свойство("query") Тогда
				Текст = Строка(Данные.query);
			КонецЕсли;
			Если Данные.Свойство("limit") И Данные.limit <> Неопределено Тогда
				Лимит = Число(Данные.limit);
			КонецЕсли;
		КонецЕсли;
		Если Лимит < 1 Тогда
			Лимит = 1;
		ИначеЕсли Лимит > 500 Тогда
			Лимит = 500;
		КонецЕсли;
		ПроверитьТолькоЧтение(Текст);
		ЗапросДанных = Новый Запрос(Текст);
		Пакет = ЗапросДанных.ВыполнитьПакет();
		Результат = Неопределено;
		Для Каждого Элемент Из Пакет Цикл
			Если Элемент <> Неопределено Тогда
				Результат = Элемент;
			КонецЕсли;
		КонецЦикла;
		ЗаписатьВыборку(Ответ, Результат, Лимит);
	Исключение
		Ответ.КодСостояния = 400;
		ЗаписатьОшибку(Ответ, Кратко(ОписаниеОшибки()));
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Процедура ПроверитьТолькоЧтение(Текст)
	Исходный = СокрЛП(Текст);
	Если Исходный = "" Тогда
		ВызватьИсключение "Пустой текст запроса.";
	КонецЕсли;
	Верхний = ВРег(Исходный);
	Если СтрНайти(Верхний, "ДЛЯ ИЗМЕНЕНИЯ") > 0 Или СтрНайти(Верхний, "FOR UPDATE") > 0 Тогда
		ВызватьИсключение "Запрос только на чтение: ДЛЯ ИЗМЕНЕНИЯ запрещено.";
	КонецЕсли;
	БылВыбор = Ложь;
	Для Каждого Оператор Из ОператорыЗапроса(Исходный) Цикл
		Голова = ВРег(Лев(Оператор, 20));
		Если СтрНачинаетсяС(Голова, "ВЫБРАТЬ") Или СтрНачинаетсяС(Голова, "SELECT") Тогда
			БылВыбор = Истина;
		ИначеЕсли ЭтоУничтожениеВременнойТаблицы(Оператор) Тогда
			Продолжить;
		Иначе
			ВызватьИсключение "Разрешён только ВЫБРАТЬ (SELECT).";
		КонецЕсли;
	КонецЦикла;
	Если Не БылВыбор Тогда
		ВызватьИсключение "В пакете нет оператора ВЫБРАТЬ.";
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьВыборку(Ответ, РезультатЗапроса, Лимит)
	Колонки = Новый Массив;
	Строки = Новый Массив;
	Обрезан = Ложь;
	Если РезультатЗапроса <> Неопределено Тогда
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			Колонки.Добавить(Колонка.Имя);
		КонецЦикла;
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Строки.Количество() >= Лимит Тогда
				Обрезан = Истина;
				Прервать;
			КонецЕсли;
			Ячейки = Новый Массив;
			Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
				Ячейки.Добавить(КакСтрока(Выборка[Колонка.Имя]));
			КонецЦикла;
			Строки.Добавить(Ячейки);
		КонецЦикла;
	КонецЕсли;
	Тело = Новый Структура;
	Тело.Вставить("columns", Колонки);
	Тело.Вставить("rows", Строки);
	Тело.Вставить("truncated", Обрезан);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
КонецПроцедуры

Процедура ЗаписатьОшибку(Ответ, Текст)
	Тело = Новый Структура("error", Текст);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);
КонецПроцедуры

Функция КакСтрока(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Лев(Значение, 400);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;
	Попытка
		Возврат Лев(XMLСтрока(Значение), 400);
	Исключение
		Возврат Лев(Строка(Значение), 400);
	КонецПопытки;
КонецФункции

Функция ОператорыЗапроса(Текст)
	Результат = Новый Массив;
	Текущий = "";
	ВСтроке = Ложь;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = """" Тогда
			ВСтроке = Не ВСтроке;
		КонецЕсли;
		Если Символ = ";" И Не ВСтроке Тогда
			Если СокрЛП(Текущий) <> "" Тогда
				Результат.Добавить(СокрЛП(Текущий));
			КонецЕсли;
			Текущий = "";
		Иначе
			Текущий = Текущий + Символ;
		КонецЕсли;
	КонецЦикла;
	Если СокрЛП(Текущий) <> "" Тогда
		Результат.Добавить(СокрЛП(Текущий));
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЭтоУничтожениеВременнойТаблицы(Оператор)
	Части = СтрРазделить(СокрЛП(Оператор), " ", Ложь);
	Если Части.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Слово = ВРег(Части[0]);
	Возврат Слово = "УНИЧТОЖИТЬ" Или Слово = "DROP";
КонецФункции

Функция Кратко(Текст)
	Одна = СтрПолучитьСтроку(Текст, 1);
	Возврат Лев(СокрЛП(Одна), 500);
КонецФункции
