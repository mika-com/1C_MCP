{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(^|__)(write|edit|text_editor)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/support-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
